# Tic-Tac-Toe Game Backend API URL
VITE_GAME_API_URL=http://localhost:8189/api

# BanditGames Platform API URL
VITE_PLATFORM_API_URL=http://localhost:8083

# ==============================================================================
# Usage Instructions:
# ==============================================================================
#
# FOR LOCAL DEVELOPMENT (npm run dev):
# - Copy this file to .env
# - Use localhost URLs as shown above
# - The app will use these values from the .env file
#
# FOR DOCKER:
# - The Dockerfile has default values (localhost) built-in
# - To override for production, pass build args in docker-compose.yml:
#
#   build:
#     context: .
#     args:
#       - VITE_GAME_API_URL=http://tictactoe-backend:8189/api
#       - VITE_PLATFORM_API_URL=http://banditgames-backend:8083
#
# ==============================================================================
